{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.local/schemas/third-party-artifact-exemptions-v1.json",
  "title": "ContextEngine third-party artifact exemptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exemptions"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exemptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_type",
          "artifact_kind",
          "disposition",
          "approval_reference"
        ],
        "properties": {
          "record_type": {
            "const": "EXEMPTION"
          },
          "artifact_kind": {
            "enum": ["wheel", "sdist", "npm", "container"]
          },
          "disposition": {
            "const": "not-produced-by-maintainer-decision"
          },
          "approval_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

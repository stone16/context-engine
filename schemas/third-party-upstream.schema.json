{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.local/schemas/third-party-upstream-v1.json",
  "title": "ContextEngine third-party registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "commit",
    "source_paths",
    "excluded_paths",
    "reuse_mode",
    "approvals",
    "license",
    "files"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "excluded_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "reuse_mode": {
      "type": "string",
      "enum": ["copy", "copy-patch"]
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "source_paths"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relativePath" }
          }
        }
      }
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
    },
    "nested_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "license", "license_path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
          },
          "license_path": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["upstream_path", "vendored_path", "sha256"],
        "properties": {
          "upstream_path": { "$ref": "#/$defs/relativePath" },
          "vendored_path": { "$ref": "#/$defs/repositoryPath" },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^third_party/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}

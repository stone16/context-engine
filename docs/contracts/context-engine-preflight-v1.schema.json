{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.invalid/contracts/context-engine-preflight-v1.schema.json",
  "title": "ContextEngine local preflight result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "service", "status", "checks"],
  "properties": {
    "schemaVersion": {"const": "context-engine-preflight-v1"},
    "service": {"const": "context-engine-control-preflight"},
    "status": {"enum": ["ready", "not_ready"]},
    "checks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {"$ref": "#/$defs/configuration"},
        {"$ref": "#/$defs/migrationSchema"},
        {"$ref": "#/$defs/controlDatabase"},
        {"$ref": "#/$defs/supplySchedulerDatabase"},
        {"$ref": "#/$defs/supplyWorkerDatabase"},
        {"$ref": "#/$defs/supplyModel"},
        {"$ref": "#/$defs/releaseLearningDatabase"},
        {"$ref": "#/$defs/releaseOperatorDatabase"},
        {"$ref": "#/$defs/runtimeRelease"},
        {"$ref": "#/$defs/runtimeModel"},
        {"$ref": "#/$defs/callerConfiguration"}
      ],
      "items": false
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "status", "category"],
      "properties": {
        "check": {"type": "string"},
        "category": {"type": "string"},
        "status": {"enum": ["ready", "failed", "not_run"]}
      }
    },
    "configuration": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "check": {"const": "configuration"},
            "category": {"enum": ["ready", "configuration_missing", "configuration_malformed"]}
          }
        }
      ]
    },
    "migrationSchema": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "check": {"const": "migration_schema"},
            "category": {"enum": ["ready", "not_selected", "dependency_not_ready", "schema_unreachable", "schema_probe_refused", "schema_not_at_head"]}
          }
        }
      ]
    },
    "database": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "category": {"enum": ["ready", "not_selected", "dependency_not_ready", "database_unavailable", "database_probe_refused"]}
          }
        }
      ]
    },
    "controlDatabase": {
      "allOf": [{"$ref": "#/$defs/database"}, {"properties": {"check": {"const": "control_database"}}}]
    },
    "supplySchedulerDatabase": {
      "allOf": [{"$ref": "#/$defs/database"}, {"properties": {"check": {"const": "supply_scheduler_database"}}}]
    },
    "supplyWorkerDatabase": {
      "allOf": [{"$ref": "#/$defs/database"}, {"properties": {"check": {"const": "supply_worker_database"}}}]
    },
    "releaseLearningDatabase": {
      "allOf": [{"$ref": "#/$defs/database"}, {"properties": {"check": {"const": "release_learning_database"}}}]
    },
    "releaseOperatorDatabase": {
      "allOf": [{"$ref": "#/$defs/database"}, {"properties": {"check": {"const": "release_operator_database"}}}]
    },
    "model": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"category": {"enum": ["ready", "not_selected", "dependency_not_ready", "model_manifest_unavailable", "model_manifest_invalid", "model_artifacts_unavailable", "model_artifacts_invalid"]}}}
      ]
    },
    "supplyModel": {
      "allOf": [{"$ref": "#/$defs/model"}, {"properties": {"check": {"const": "supply_model"}}}]
    },
    "runtimeModel": {
      "allOf": [{"$ref": "#/$defs/model"}, {"properties": {"check": {"const": "runtime_model"}}}]
    },
    "runtimeRelease": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "check": {"const": "runtime_release"},
            "category": {"enum": ["ready", "not_selected", "dependency_not_ready", "runtime_unreachable", "runtime_probe_refused", "runtime_identity_not_current", "active_release_absent", "active_release_incompatible"]}
          }
        }
      ]
    },
    "callerConfiguration": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"check": {"const": "caller_configuration"}, "category": {"enum": ["ready", "not_selected", "dependency_not_ready", "caller_configuration_invalid"]}}}
      ]
    }
  }
}

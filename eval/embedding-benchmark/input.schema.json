{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.invalid/eval/embedding-benchmark/input.schema.json",
  "title": "ContextEngine offline embedding benchmark input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documents", "cases"],
  "properties": {
    "schemaVersion": {"const": "context-engine-embedding-benchmark-input-v1"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentRef", "text"],
        "properties": {
          "documentRef": {"$ref": "#/$defs/nonblank"},
          "text": {"$ref": "#/$defs/nonblank"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseRef", "query", "expectedDocumentRefs", "slice"],
        "properties": {
          "caseRef": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$"},
          "query": {"$ref": "#/$defs/nonblank"},
          "expectedDocumentRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/nonblank"}
          },
          "slice": {"$ref": "#/$defs/nonblank"}
        }
      }
    }
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
  }
}
